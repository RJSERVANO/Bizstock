# Copy to .env. Process environment values take precedence.
APP_ENV=local
# Empty at the site root, or /bizstock for an Apache Alias to public/.
APP_BASE_PATH=
# Public homepage identity. Use only a verified business contact email; empty shows administrator guidance.
APP_BUSINESS_NAME=BizStock
APP_CONTACT_EMAIL=
APP_CURRENCY=PHP
APP_TIMEZONE=Asia/Manila
DB_HOST=127.0.0.1
# mysql84 for production; mariadb104-local explicitly allows only 10.4.32 in local/test.
DB_TARGET=mysql84
DB_PORT=3306
DB_NAME=bizstock
DB_USER=bizstock
DB_PASSWORD=
# Private writable path outside public/. Relative paths are project-relative.
APP_LOG_PATH=var/logs/app.log
# Authenticated idle/absolute lifetime; absolute >= idle. Test-only minimum is 1 second.
# local/production idle minimum 300; idle maximum 86400; absolute maximum 604800.
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=28800
